# Application Port
PORT=8000

# Database Configuration
DATABASE_URL=postgres://vantage_admin:dev_secret_password@localhost:5432/vantage_db

# Redis Configuration (BullMQ Queue & Idempotency Locks)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Credential Vault Master Key (Must be 32 bytes / 64 hex characters for AES-256-GCM)
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef